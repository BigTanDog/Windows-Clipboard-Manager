<Application x:Class="ClipboardManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:imaging="clr-namespace:ClipboardManager.App.Imaging"
             ShutdownMode="OnExplicitShutdown">
    <!-- 注意：不设置 StartupUri —— 主窗口由 AppHost 按需创建与显示 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题字典：启动时由 ThemeManager 按设置（system/light/dark）整体替换 -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- 控件外观（圆角/深色适配）：与主题字典分离，切主题时不需要重建 -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 缩略图惰性加载（配合列表虚拟化，只有可见行才解码；加载后不锁文件） -->
            <imaging:ThumbnailConverter x:Key="ThumbnailConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
