<Application x:Class="ClipboardManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:imaging="clr-namespace:ClipboardManager.App.Imaging"
             ShutdownMode="OnExplicitShutdown">
    <!-- 注意：不设置 StartupUri —— 主窗口由 AppHost 按需创建与显示 -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- 缩略图惰性加载（配合列表虚拟化，只有可见行才解码；加载后不锁文件） -->
            <imaging:ThumbnailConverter x:Key="ThumbnailConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E5DED0" />

            <!-- 第一版配色（暖米白，与用户偏好一致）。深浅色跟随在阶段三接入，
                 届时这些键会被主题字典整体替换；因此控件一律只引用这些键，不写死颜色。 -->
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F8F5EE" />
            <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#EFE9DD" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#DED5C4" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2A2621" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6F6558" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#E3E9FA" />
            <SolidColorBrush x:Key="HoverBrush" Color="#EAE4D8" />

            <!-- 列表项样式：紧凑工具风（参考 Ditto 的信息密度） -->
            <Style x:Key="ClipItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <!-- 把显示文本暴露给 UI Automation：屏幕阅读器可读，自动化冒烟测试也能直接断言 -->
                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Margin="6,1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    CornerRadius="4">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 无边框小按钮（关闭按钮用） -->
            <Style x:Key="FlatIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
