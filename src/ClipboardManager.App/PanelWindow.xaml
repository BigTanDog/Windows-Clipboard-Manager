<Window x:Class="ClipboardManager.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史"
        Width="460"
        Height="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{StaticResource PanelBackgroundBrush}">

    <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" Padding="12,8,12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="剪贴板历史" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               x:Name="CountText" />
                    <Button Grid.Column="2"
                            Style="{StaticResource FlatIconButtonStyle}"
                            Click="OnCloseButtonClick"
                            ToolTip="关闭面板（Esc）"
                            Content="✕" />
                </Grid>
            </Border>

            <!-- 搜索框 -->
            <Grid Grid.Row="1" Margin="12,8,12,4">
                <TextBox x:Name="SearchBox"
                         Padding="6,4"
                         BorderBrush="{StaticResource PanelBorderBrush}"
                         BorderThickness="1"
                         Background="{StaticResource PanelBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         CaretBrush="{StaticResource PrimaryTextBrush}"
                         TextChanged="OnSearchTextChanged"
                         PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock x:Name="SearchHint"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="搜索文字内容或文件名" />
            </Grid>

            <!-- 记录列表：虚拟化 + 回收，保证数百条仍然流畅 -->
            <ListBox x:Name="ItemsList"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,4"
                     ItemContainerStyle="{StaticResource ClipItemStyle}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     PreviewKeyDown="OnListPreviewKeyDown"
                     PreviewMouseLeftButtonUp="OnListMouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 类型徽标 -->
                            <Border Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="5,1"
                                    VerticalAlignment="Top"
                                    CornerRadius="3"
                                    Background="{StaticResource BadgeBackgroundBrush}">
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding TypeLabel}" />
                            </Border>

                            <!-- 图片缩略图（只有图片记录才显示） -->
                            <Border Grid.Column="1"
                                    Margin="0,0,8,0"
                                    CornerRadius="3"
                                    Background="{StaticResource BadgeBackgroundBrush}"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Width="60"
                                       Height="60"
                                       Stretch="Uniform"
                                       Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailConverter}}" />
                            </Border>

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="{Binding DisplayText}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Tooltip}" />
                            <TextBlock Grid.Column="3"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="{Binding TimeText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态提示 -->
            <TextBlock x:Name="EmptyHint"
                       Grid.Row="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Visibility="Collapsed"
                       TextAlignment="Center"
                       Text="还没有记录&#x0a;复制任意文字后会自动出现在这里" />

            <Border Grid.Row="3" Background="{StaticResource HeaderBackgroundBrush}" Padding="12,6">
                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="单击 / Enter 粘贴 · ↑↓ 选择 · Delete 删除 · Esc 关闭" />
            </Border>
        </Grid>
    </Border>
</Window>
