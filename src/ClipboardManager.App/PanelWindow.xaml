<Window x:Class="ClipboardManager.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史"
        Width="420"
        Height="436"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- 窗口本身透明（AllowsTransparency）：圆角、底色与阴影都由这张卡片负责，
         这样亚克力模糊才能透出来，圆角外也能真正点到桌面（逐像素命中测试）。 -->
    <Border x:Name="RootSurface"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{DynamicResource PanelBackgroundBrush}">
        <!-- 说明：这里刻意不加 DropShadowEffect —— 逐像素透明窗口上做投影会把首次弹出耗时从 84ms 抬到
             114ms（超过需求 §8 第 2 条的 100ms 目标，实测），1px 边框已经足够分割面板与桌面。 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="12,8,12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="剪贴板历史" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               x:Name="CountText" />
                    <Button Grid.Column="2"
                            Style="{StaticResource FlatIconButtonStyle}"
                            Click="OnCloseButtonClick"
                            ToolTip="关闭面板（Esc）"
                            Content="✕" />
                </Grid>
            </Border>

            <!-- 搜索框 -->
            <Grid Grid.Row="1" Margin="12,8,12,4">
                <TextBox x:Name="SearchBox"
                         Padding="6,4"
                         BorderBrush="{DynamicResource PanelBorderBrush}"
                         BorderThickness="1"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                         TextChanged="OnSearchTextChanged"
                         PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock x:Name="SearchHint"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="搜索文字内容或文件名" />
            </Grid>

            <!-- 磁盘上限提示（D-09：只剩收藏仍超限时提示用户，不自动删除） -->
            <Border x:Name="QuotaHint"
                    Grid.Row="2"
                    Margin="12,4,12,0"
                    Padding="8,5"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource WarningBackgroundBrush}">
                <TextBlock x:Name="QuotaHintText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource WarningTextBrush}" />
            </Border>

            <!-- 记录列表：虚拟化 + 回收，保证数百条仍然流畅 -->
            <ListBox x:Name="ItemsList"
                     Grid.Row="3"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,4"
                     ItemContainerStyle="{StaticResource ClipItemStyle}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     PreviewKeyDown="OnListPreviewKeyDown"
                     PreviewMouseLeftButtonUp="OnListMouseLeftButtonUp"
                     PreviewMouseRightButtonDown="OnListMouseRightButtonDown"
                     ContextMenuOpening="OnListContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu Style="{StaticResource ClipContextMenuStyle}"
                                 Opened="OnContextMenuOpened"
                                 Closed="OnContextMenuClosed">
                        <MenuItem x:Name="MenuPaste" Header="粘贴" Click="OnMenuPasteClick" />
                        <MenuItem x:Name="MenuPin" Header="收藏" Click="OnMenuPinClick" />
                        <Separator />
                        <MenuItem x:Name="MenuDelete" Header="删除" Click="OnMenuDeleteClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 收藏标记 -->
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource PinnedBrush}"
                                       Text="{Binding PinGlyph}" />

                            <!-- 类型徽标：每种内容一套柔和配色 + 矢量小图标（文本/图片/文件/网站/HTML） -->
                            <Border Grid.Column="1" Style="{StaticResource KindChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource KindChipIconStyle}" />
                                    <TextBlock Style="{StaticResource KindChipTextStyle}" Text="{Binding KindLabel}" />
                                </StackPanel>
                            </Border>

                            <!-- 图片缩略图（只有图片记录才显示） -->
                            <Border Grid.Column="2"
                                    Margin="0,0,8,0"
                                    CornerRadius="3"
                                    Background="{DynamicResource BadgeBackgroundBrush}"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Width="60"
                                       Height="60"
                                       Stretch="Uniform"
                                       Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailConverter}}" />
                            </Border>

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Text="{Binding DisplayText}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Tooltip}" />
                            <TextBlock Grid.Column="4"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="{Binding TimeText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态提示 -->
            <TextBlock x:Name="EmptyHint"
                       Grid.Row="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Visibility="Collapsed"
                       TextAlignment="Center"
                       Text="还没有记录&#x0a;复制任意文字后会自动出现在这里" />

            <Border x:Name="FooterBar" Grid.Row="4" Background="{DynamicResource HeaderBackgroundBrush}" Padding="12,4,8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Text="单击 / Enter 粘贴 · ↑↓ 选择 · Delete 删除 · 右键收藏 · Esc 关闭" />
                    <!-- 齿轮：直接打开设置窗口（省得去托盘右键） -->
                    <Button x:Name="SettingsButton"
                            Grid.Column="1"
                            Style="{StaticResource FlatIconButtonStyle}"
                            Click="OnSettingsButtonClick"
                            ToolTip="打开设置">
                        <Path Width="14"
                              Height="14"
                              Data="{StaticResource IconGear}"
                              Fill="Transparent"
                              Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.3" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
