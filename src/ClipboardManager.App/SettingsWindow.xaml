<Window x:Class="ClipboardManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 剪贴板管理器"
        Width="470"
        Height="620"
        MinWidth="470"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="16,14,16,10">

                <!-- ─────────── 记录 ─────────── -->
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="记录" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="记录条数上限" />
                    <ComboBox x:Name="MaxItemsBox" Grid.Column="1" Height="28" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="磁盘占用上限" />
                    <ComboBox x:Name="DiskQuotaBox" Grid.Column="1" Height="28" />
                </Grid>

                <!-- 当前占用（实时刷新）+ 一键打开缓存目录 -->
                <Border Margin="0,0,0,8"
                        Padding="10,8"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="UsageText"
                                       FontWeight="SemiBold"
                                       Text="当前占用统计中…" />
                            <TextBlock x:Name="UsageDetailText"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="OpenCacheFolderButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                MinWidth="0"
                                Padding="10,0"
                                Style="{StaticResource DialogButtonStyle}"
                                ToolTip="在资源管理器里打开缓存目录（图片 / 富文本本体所在位置）"
                                Content="打开缓存文件夹"
                                Click="OnOpenCacheFolderClick" />
                    </Grid>
                </Border>

                <TextBlock Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="超出上限时按「体积最大优先、同级最旧优先」淘汰；收藏的记录永不自动删除。" />
                <CheckBox x:Name="CaptureImagesBox" Margin="0,0,0,14" Content="记录图片（截图 / 复制的图片）" />

                <!-- ─────────── 交互 ─────────── -->
                <TextBlock FontWeight="SemiBold" Margin="0,4,0,8" Text="交互" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="全局快捷键" />
                    <!-- 按键录制框：点击后直接按组合键，不用手输（Esc 取消） -->
                    <TextBox x:Name="HotkeyBox"
                             Grid.Column="1"
                             Height="28"
                             Padding="8,3"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             Cursor="Hand"
                             GotFocus="OnHotkeyBoxGotFocus"
                             LostFocus="OnHotkeyBoxLostFocus"
                             PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"
                             PreviewMouseLeftButtonDown="OnHotkeyBoxMouseDown"
                             ToolTip="点击后直接按下想用的组合键；Esc 取消" />
                </Grid>
                <TextBlock x:Name="HotkeyHint"
                           Margin="150,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="点击输入框后直接按下组合键即可（如按住 Ctrl+Shift 再按 V），无需手输；Esc 取消。被其它程序占用时保存会提示换键。" />
                <CheckBox x:Name="AutoPasteBox" Margin="0,0,0,8" Content="粘贴后自动向原窗口发送 Ctrl+V" />
                <CheckBox x:Name="MaskBox" Margin="0,0,0,4" Content="敏感信息脱敏显示（手机号 / 账号等只显示前几位）" />
                <TextBlock Margin="24,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="仅影响列表显示：粘贴出去的仍是原文。" />
                <CheckBox x:Name="ClearClipboardOnDeleteBox"
                          Margin="0,0,0,4"
                          Content="删除记录时，如果它正是当前剪贴板内容，同时清空剪贴板" />
                <TextBlock Margin="24,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="默认开启：删掉之后桌面右键的「粘贴」会立刻变灰，不会再粘出已删除的内容（面板上带「剪贴板中」徽标的就是这一条）。只清系统当前剪贴板；Win+V 历史里的副本和已经粘贴出去的内容不受影响。" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="主题" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Height="28" />
                </Grid>
                <CheckBox x:Name="HideOnClickOutsideBox"
                          Margin="0,0,0,8"
                          Content="点击面板外部时自动隐藏" />
                <CheckBox x:Name="SingleClickPasteBox"
                          Margin="0,0,0,4"
                          Content="单击条目即粘贴并收起面板" />
                <TextBlock Margin="24,0,0,8"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="默认关闭：单击只选中，双击或 Enter 粘贴（避免想选中看看时面板被收起）。" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="面板透明度" />
                    <Slider x:Name="AcrylicSlider"
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            Minimum="0"
                            Maximum="100"
                            IsSnapToTickEnabled="True"
                            TickFrequency="5"
                            ValueChanged="OnAcrylicStrengthChanged"
                            ToolTip="0 = 不透明；数值越大越透（最多 35%）" />
                    <TextBlock x:Name="AcrylicValueText"
                               Grid.Column="2"
                               MinWidth="62"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="0（不透明）" />
                </Grid>
                <TextBlock Margin="150,0,0,14"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="拖动即时预览面板效果；0 = 不透明，最高 35%（保证内容可读）。" />

                <!-- ─────────── 启动与排除 ─────────── -->
                <TextBlock FontWeight="SemiBold" Margin="0,4,0,8" Text="启动与排除" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="AutoStartBox" VerticalAlignment="Center" Content="开机自启" />
                    <TextBlock Margin="16,0,6,0" VerticalAlignment="Center" Text="延迟启动" />
                    <TextBox x:Name="AutoStartDelayBox" Width="48" Height="26" Padding="4,2" HorizontalContentAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="秒（0 = 立即启动）" />
                </StackPanel>
                <CheckBox x:Name="ExcludeByProcessBox" Margin="0,0,0,8" Content="按来源进程名排除（辅助手段）" />
                <TextBlock Margin="0,0,0,6"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="标记「不要进剪贴板历史」的程序（多数密码管理器）始终会被跳过，无需在此配置。" />
                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Height="96">
                    <ListBox x:Name="ExcludedListBox" BorderThickness="0" Background="Transparent" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="ExcludedInput" Width="200" Height="28" Padding="6,3" />
                    <Button x:Name="ExcludedAddButton" Style="{StaticResource DialogButtonStyle}" Content="添加" Click="OnAddExcludedClick" />
                    <Button x:Name="ExcludedRemoveButton" Style="{StaticResource DialogButtonStyle}" Content="移除选中" Click="OnRemoveExcludedClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button Style="{StaticResource DialogButtonStyle}" Content="取消" Click="OnCancelClick" />
                <Button Style="{StaticResource AccentButtonStyle}" Content="保存" Click="OnSaveClick" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
