<Window x:Class="ClipboardManager.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 剪贴板管理器"
        Width="470"
        Height="620"
        MinWidth="470"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="16,14,16,10">

                <!-- ─────────── 记录 ─────────── -->
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="记录" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="记录条数上限" />
                    <ComboBox x:Name="MaxItemsBox" Grid.Column="1" Height="28" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="磁盘占用上限" />
                    <ComboBox x:Name="DiskQuotaBox" Grid.Column="1" Height="28" />
                </Grid>
                <TextBlock Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="超出上限时按「体积最大优先、同级最旧优先」淘汰；收藏的记录永不自动删除。" />
                <CheckBox x:Name="CaptureImagesBox" Margin="0,0,0,14" Content="记录图片（截图 / 复制的图片）" />

                <!-- ─────────── 交互 ─────────── -->
                <TextBlock FontWeight="SemiBold" Margin="0,4,0,8" Text="交互" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="全局快捷键" />
                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Height="28" Padding="6,3" />
                </Grid>
                <TextBlock x:Name="HotkeyHint"
                           Margin="150,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="格式如 Ctrl+Shift+V；被其它程序占用时启动会提示换键。" />
                <CheckBox x:Name="AutoPasteBox" Margin="0,0,0,8" Content="粘贴后自动向原窗口发送 Ctrl+V" />
                <CheckBox x:Name="MaskBox" Margin="0,0,0,4" Content="敏感信息脱敏显示（手机号 / 账号等只显示前几位）" />
                <TextBlock Margin="24,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="仅影响列表显示：粘贴出去的仍是原文。" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="主题" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Height="28" />
                </Grid>

                <!-- ─────────── 启动与排除 ─────────── -->
                <TextBlock FontWeight="SemiBold" Margin="0,4,0,8" Text="启动与排除" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="AutoStartBox" VerticalAlignment="Center" Content="开机自启" />
                    <TextBlock Margin="16,0,6,0" VerticalAlignment="Center" Text="延迟启动" />
                    <TextBox x:Name="AutoStartDelayBox" Width="48" Height="26" Padding="4,2" HorizontalContentAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="秒（0 = 立即启动）" />
                </StackPanel>
                <CheckBox x:Name="ExcludeByProcessBox" Margin="0,0,0,8" Content="按来源进程名排除（辅助手段）" />
                <TextBlock Margin="0,0,0,6"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="标记「不要进剪贴板历史」的程序（多数密码管理器）始终会被跳过，无需在此配置。" />
                <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4" Height="96">
                    <ListBox x:Name="ExcludedListBox" BorderThickness="0" Background="Transparent" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox x:Name="ExcludedInput" Width="200" Height="28" Padding="6,3" />
                    <Button x:Name="ExcludedAddButton" Style="{StaticResource DialogButtonStyle}" Content="添加" Click="OnAddExcludedClick" />
                    <Button x:Name="ExcludedRemoveButton" Style="{StaticResource DialogButtonStyle}" Content="移除选中" Click="OnRemoveExcludedClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button Style="{StaticResource DialogButtonStyle}" Content="取消" Click="OnCancelClick" />
                <Button Style="{StaticResource DialogButtonStyle}" Content="保存" Click="OnSaveClick" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
